# Copy to .env and fill in. Only needed for live mode (./run.sh start --execute).
# Paper mode (./run.sh) needs none of this.

# --- account (required for --execute) ---
PM_PRIVATE_KEY=                 # signer private key of the account holder; use a dedicated account
PM_FUNDER=                      # Polymarket wallet address (proxy/safe/deposit); empty = SDK default deposit wallet

# --- gasless redemption (required for --execute: $50 only lasts if winnings are redeemed every window) ---
# Create in polymarket.com > Settings > API Keys (Relayer API key).
PM_RELAYER_API_KEY=
PM_RELAYER_API_KEY_ADDRESS=

# --- quoting (defaults sized for a $50 test) ---
MR_KINDS=5m                     # 5m, or 5m,15m (15m doubles the capital tied up)
MR_ORDER_USD=2.5                # per resting bid; the cheap side rests more shares, so leftovers are cheap
MR_ORDER_SHARES=5               # minimum shares per order (Polymarket minimum)
MR_MAX_MARKET_USD=12            # spend cap per window
MR_PAIR_CAP=0.97                # max avg(Up)+avg(Down); reference wallet pair-weighted median 0.941
MR_MAX_IMBALANCE_USD=2.5        # value one side may be ahead by before it stops bidding (one unhedged order)
MR_MIN_PRICE=0.01
MR_MAX_PRICE=0.97
MR_START_DELAY_SECS=3
MR_STOP_SECS=5                  # cancel all bids this many seconds before close
MR_IMPROVE=1                    # step one tick inside the spread when possible
MR_TAKER_HEDGE=1                # complete a naked side at the ask when avg + ask + fee <= MR_PAIR_CAP
MR_TAKER_FEE_PCT=2              # taker fee, % of taker notional (reference wallet pays ~2%); 0 disables the hedge

# --- BTC-driven pulls (cancel before the Polymarket book reacts to a BTC move) ---
MR_SPOT_URL=wss://data-stream.binance.vision/ws/btcusdt@trade   # any reachable BTC trade stream with Binance's format
MR_BTC_VOL=0.35                 # annualised vol used to turn a BTC move into a fair-price move
MR_PULL_TICKS=1.5               # pull when the implied fair-price move reaches this many ticks
MR_PULL_WINDOW_SECS=2           # ... over this many seconds of BTC trades
MR_PULL_COOLDOWN_SECS=2         # stay out this long after a pull (the book lags BTC by ~0.6-1.5s)
MR_SPOT_STALE_SECS=3            # no BTC trade for this long: pull and stop quoting

# --- risk / run control ---
MR_MAX_LOSS_USD=15              # stop when equity falls this far below the starting equity
MR_RUN_MINUTES=                 # empty = run until ./run.sh stop

# --- report ---
MR_REF_WALLET=0x21f4c1a1be34a39a7bc20985df4b7e5a39fb691d
MR_TAKER_REBATE_PCT=0.18        # your Taker Rebate tier (Gold 0.18); 0 if unknown
